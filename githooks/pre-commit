#!/bin/sh
# Pre-commit hook — P0 启动自检 (v8.6.12)
# ============================================================
# 用途: git commit 前自动执行 P0 自检,阻止有问题的代码进入仓库
#
# 安装方式 (任选其一):
#
#   方式 A (推荐,团队共享):
#     git config core.hooksPath githooks
#     # hook 脚本入 git,所有成员自动生效
#
#   方式 B (个人,立即生效):
#     cp githooks/pre-commit .git/hooks/pre-commit
#     chmod +x .git/hooks/pre-commit
#
# 跳过方式 (紧急情况):
#   SKIP_P0_CHECK=1 git commit -m "..."   # 跳过自检
#
# 退出码:
#   0 = 允许提交
#   1 = 阻止提交 (必须修复后重试)
# ============================================================

# 切到仓库根 (git 在 hook 执行时已自动设 GIT_DIR,但 cd 更稳妥)
REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null)
if [ -z "$REPO_ROOT" ]; then
    echo "[pre-commit] 无法定位仓库根目录,容错通过"
    exit 0
fi

# 优先用 python,回退到 python3 / py
PYTHON_BIN="python"
if ! command -v $PYTHON_BIN >/dev/null 2>&1; then
    PYTHON_BIN="python3"
fi
if ! command -v $PYTHON_BIN >/dev/null 2>&1; then
    PYTHON_BIN="py"
fi
if ! command -v $PYTHON_BIN >/dev/null 2>&1; then
    echo "[pre-commit] 未找到 python,容错通过"
    exit 0
fi

# 调用 Python 包装器
exec $PYTHON_BIN "$REPO_ROOT/scripts/pre_commit_check.py"
