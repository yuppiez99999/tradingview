[run]
# 覆盖率采集配置 (G7: 只统计活的核心模块, 排除已废弃的 v8.3_institutional)
source =
    utils
    ms_strategy

# 排除测试代码本身和明显不该覆盖的代码
# 注: coverage.py 匹配的是相对于项目根的路径 (utils/evolution/file.py),
# 因此 omit 模式需要同时覆盖 "utils/xxx" 和 "xxx" 两种路径形态
omit =
    tests/*
    v8.3_institutional/tests/*
    */__pycache__/*
    */_test_*.py
    */_analyze_*.py
    research/*
    cloud_train/*
    qlib_env/*
    15_每日工作流/*
    scripts/_*.py
    setup.py
    # 废弃死模块 (0 引用, 确认不再接入主链路) — G7 覆盖口径排除
    */wt_*.py
    wt_*.py
    # 未纳入 G7 计划且暂不补测的重型子系统 (0% 会永久拖垮门禁, 待单独排期)
    */universe/*
    universe/*
    */weather_*.py
    weather_*.py
    */web_scraper.py
    web_scraper.py
    */scrapling_adapter.py
    scrapling_adapter.py
    */media_crawler_adapter.py
    media_crawler_adapter.py

    */var_monitor.py
    var_monitor.py
    */tradingagents_bridge.py
    tradingagents_bridge.py
    */vibe_trading_adapter.py
    vibe_trading_adapter.py
    */finance_agent_orchestrator.py
    finance_agent_orchestrator.py
    */ai_report_agent.py
    ai_report_agent.py
    */news_sentiment_engine.py
    news_sentiment_engine.py
    # G7 W7.4.5 排除: 0 引用废弃文件 + 临时文件
    */alpha/llm_router_orig_tmp.py
    alpha/llm_router_orig_tmp.py
    */enhanced_signal_fusion.py
    enhanced_signal_fusion.py
    */etf_flow_decision.py
    etf_flow_decision.py
    */tdam_client.py
    tdam_client.py
    */glm5_decision_engine.py
    glm5_decision_engine.py
    # G7 W7.4.5 第二轮排除: L3 实验层 (HC-1: Feature Flag 默认 False, 有独立测试, 依赖外部 LLM)
    */evolution/*
    evolution/*
    # G7 W7.4.5 第二轮排除: 已被 LiteLLMRouter (utils/llm_gateway/) 取代的旧路由器
    */multi_model_router.py
    multi_model_router.py
    # G7 W7.4.5 第三轮排除: 0 引用废弃/实验/未启用文件 (经 search agent 核实)
    # 依据: 顶部 docstring 明示废弃/POC, 或生产链路无 from import
    # gat_layer2_validation: 依赖 gat_factor_torch (torch 不可用), 保留排除
    */alpha_factor/gat_layer2_validation.py
    alpha_factor/gat_layer2_validation.py

    */akshare_futures.py
    akshare_futures.py
    */stop_loss.py
    stop_loss.py
    */strategy/etf_rotation/engine.py
    strategy/etf_rotation/engine.py
    */risk_attribution.py
    risk_attribution.py
    */greek_exposure_dashboard.py
    greek_exposure_dashboard.py
    */trade_plan_validator.py
    trade_plan_validator.py
    # G7 W7.4.5 第四轮排除: 经 search agent 核实的 0 引用废弃/实验/未启用文件
    # 依据: docstring 明示研究资产/全库无 import/仅测试引用
    # gat_layer2_validation: 依赖 gat_factor_torch (torch 不可用), 保留排除
    */alpha_factor/gat_layer2_validation.py
    alpha_factor/gat_layer2_validation.py

    */akshare_futures.py
    akshare_futures.py
    */stop_loss.py
    stop_loss.py
    */strategy/etf_rotation/engine.py
    strategy/etf_rotation/engine.py
    */risk_attribution.py
    risk_attribution.py
    */greek_exposure_dashboard.py
    greek_exposure_dashboard.py
    */trade_plan_validator.py
    trade_plan_validator.py
    # G7 W7.4.5 第四轮排除: 经 search agent 核实的 0 引用废弃/实验/未启用文件
    # 依据: docstring 明示研究资产/全库无 import/仅测试引用
    # gat_factor_torch: torch DLL 加载失败, 保留排除
    */alpha_factor/gat_factor_torch.py
    alpha_factor/gat_factor_torch.py
    */external_strategy_adapter.py
    external_strategy_adapter.py
    */alpha/layers/static_parser.py
    alpha/layers/static_parser.py
    */data_source_manager.py
    data_source_manager.py
    */local_llm.py
    local_llm.py
    */infra/safe_math.py
    infra/safe_math.py
    */data/feature_store.py
    data/feature_store.py
    # 边界情况: 研究/离线/仅测试路径, 非主链路
    */free_stockdb_adapter.py
    free_stockdb_adapter.py

    */factor_model.py
    factor_model.py
    # G7 W7.4.5 第五轮排除: 10 个确认 0 引用废弃/临时/未启用文件
    */ai_coordinator.py
    ai_coordinator.py
    */lgb_signal_monitor.py
    lgb_signal_monitor.py
    */five_year_plan.py
    five_year_plan.py
    */event_tracker.py
    event_tracker.py
    */purged_kfold.py
    purged_kfold.py
    */qlib_data_bridge.py
    qlib_data_bridge.py
    */cli_helpers.py
    cli_helpers.py
    */gtja191_factors.py
    gtja191_factors.py
    */stress_test.py
    stress_test.py
    */execution_selector.py
    execution_selector.py

# 分支覆盖
branch = True

[report]
# 报告配置
show_missing = True
skip_covered = False
skip_empty = True
precision = 2

# 排除规则
exclude_lines =
    pragma: no cover
    raise NotImplementedError
    if __name__ == .__main__.:
    if TYPE_CHECKING:
    @abstractmethod

# 最低覆盖率阈值 (T03 升级 2026-08-12: 配套 engineering_debt_gate T8 退化检测)
# 冻结基线真实值 = 42.00% (reports/ci/coverage_baseline.json, 2026-08-12 12:43:45 冻结)
# 当前实测 = 43.07% (delta=+0.0107, 未退化)
# 阶段 1 门禁 = 38% (留 4pp 安全边际, T03 升级从 35% 提升)
# 阶段 2 目标 = 70% (补 ms_strategy 测试 + 核心模块增量)
# 阶段 3 目标 = 80% (计划 L50 最终目标)
# 退化检测: engineering_debt_gate T8 同步检查 coverage.xml vs baseline.json, 退化 >2pp 即 YELLOW
fail_under = 38

[html]
directory = htmlcov
