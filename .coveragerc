[run]
# 覆盖率采集配置
source =
    utils
    v8.3_institutional/src
    v8.3_institutional/daily_workflow.py

# 排除测试代码本身和明显不该覆盖的代码
omit =
    tests/*
    v8.3_institutional/tests/*
    */__pycache__/*
    */_test_*.py
    */_analyze_*.py
    research/*
    cloud_train/*
    qlib_env/*
    15_每日工作流/*
    scripts/_*.py
    setup.py

# 分支覆盖
branch = True

[report]
# 报告配置
show_missing = True
skip_covered = False
skip_empty = True
precision = 2

# 排除规则
exclude_lines =
    pragma: no cover
    raise NotImplementedError
    if __name__ == .__main__.:
    if TYPE_CHECKING:
    @abstractmethod

# 最低覆盖率阈值 (GAP-3: 渐进式, 阶段 1 = 60%, 阶段 2 升 70%, 阶段 3 后 80%)
# 实际覆盖率 65.20%, 留 5% 安全边际
fail_under = 60

[html]
directory = htmlcov
