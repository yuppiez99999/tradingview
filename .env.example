# ============================================================
# .env.example — 量化交易系统环境变量模板
# ============================================================
# 复制本文件为 .env 并填入真实值即可;
# 未填写的模型会自动降级到 MockProvider (系统仍可完整跑通, 仅 Shadow 记录).
# 所有 Key 均通过环境变量读取, 不写死在代码中.
# P2 修复 (2026-09-09): 补齐 .env 实际使用的全部变量 (原仅 6 个, 漂移 14 个).

# === 数据源 ===
# Wind 数据终端 MCP (P1 主数据源)
WIND_API_KEY=
# ModelScope 模型下载 Token
MODELSCOPE_TOKEN=

# === AI 模型 ===
# DeepSeek — 信号计算/代码 (role: signal/bull)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
DEEPSEEK_MODEL=
DEEPSEEK_REASONER_MODEL=
# 智谱 GLM-5.2 — 合规审计/中文金融 (role: compliance/bear)
GLM_API_KEY=
# Kimi3 (Moonshot) — 研报图表多模态 (role: research)
MOONSHOT_API_KEY=
# Claude — 深度推理/风控 (role: reasoning/judge)
CLAUDE_API_KEY=
# GPT (OpenAI) — 盘中研判 (role: intraday)
OPENAI_API_KEY=
# APIZero — 外部 API 探测脚本
APIZERO_API_KEY=
# Ollama 本地模型
OLLAMA_MODEL=
OLLAMA_NUM_GPUS=

# === TDAM 通达信 ===
TDAM_AGENT_ID=
TDAM_BASE_URL=
TDAM_TEAM_ID=

# === 交易环境 ===
# shadow / paper / live
TRADING_ENV=

# === Shadow 账户配置 ===
SHADOW_TOTAL_CAPITAL=
SHADOW_INITIAL_CAPITAL=
SHADOW_CAPITAL_PCT=

# === 运行模式覆盖 (可选) ===
# AI_DECISION_MODE=shadow
