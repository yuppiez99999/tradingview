#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""DriftDetector: 策略漂移检测器."""

import json
import math
from datetime import datetime, timedelta
from typing import Dict, Optional, List
import numpy as np
from pathlib import Path
from scipy import stats

class DriftStatus: NO_DRIFT = "no_drift"; DETECTED = "detected"; INSUFFICIENT_DATA = "insufficient_data"

class DriftDetector:
    def __init__(self, detection_window: int = 30, baseline_window: int = 90, significance_level: float = 0.05):
        self.detection_window = detection_window; self.baseline_window = baseline_window
        self.significance_level = significance_level
        self.cache_path = Path("cache/drift_cache.json"); self._load_cache()
    
    def _load_cache(self):
        if self.cache_path.exists():
            try:
                with open(self.cache_path, 'r') as f: self.cache = json.load(f)
            except Exception: self.cache = {}
        else: self.cache = {}
    
    def _save_cache(self):
        try: self.cache_path.parent.mkdir(parents=True, exist_ok=True);
             with open(self.cache_path, 'w') as f: json.dump(self.cache, f, indent=2, ensure_ascii=False)
        except Exception: pass
    
    def check_drift(self, code: str, recent_ic: List[float], historical_ic: List[float]) -> Dict:
        key = f"{code}_{len(recent_ic)}_{len(historical_ic)}"
        if key in self.cache:
            cache_entry = self.cache[key]
            age = (datetime.now() - datetime.fromisoformat(cache_entry['timestamp'])).total_seconds()
            if age < 3600: return cache_entry['result']
        
        if len(recent_ic) < self.detection_window or len(historical_ic) < self.baseline_window:
            result = {'status': DriftStatus.INSUFFICIENT_DATA, 'reason': 'insufficient_data',
                      'recent_mean': float(np.mean(recent_ic)) if recent_ic else None,
                      'historical_mean': float(np.mean(historical_ic)) if historical_ic else None,
                      'p_value': None, 'trigger_retrain': False, 'timestamp': datetime.now().isoformat()}
            self.cache[key] = {'timestamp': datetime.now().isoformat(), 'result': result}; self._save_cache()
            return result
        
        recent_mean = np.mean(recent_ic); historical_mean = np.mean(historical_ic)
        mean_change_rate = abs(recent_mean - historical_mean) / (abs(historical_mean) + 1e-9)
        try:
            ks_stat, p_value = stats.kstest(recent_ic, lambda x: np.histogram(historical_ic, bins=15, density=True)[0])
        except Exception: p_value = 1.0
        
        detected = mean_change_rate > 0.3 or p_value < self.significance_level
        result = {
            'status': DriftStatus.DETECTED if detected else DriftStatus.NO_DRIFT,
            'recent_mean': round(float(recent_mean), 6), 'historical_mean': round(float(historical_mean), 6),
            'recent_std': round(float(np.std(recent_ic, ddof=1)), 6), 'historical_std': round(float(np.std(historical_ic, ddof=1)), 6),
            'mean_change_rate': round(float(mean_change_rate), 4), 'ks_stat': round(float(ks_stat), 6),
            'p_value': round(float(p_value), 6), 'trigger_retrain': detected, 'timestamp': datetime.now().isoformat()
        }
        self.cache[key] = {'timestamp': datetime.now().isoformat(), 'result': result}; self._save_cache()
        return result
    
    def update_ic(self, code: str, new_ic: float, history_window: int = 100) -> None: pass
