def adaptive_optimize(symbol: str, base_config: Dict, cv_results: List[Dict]) -> Dict:
    if not cv_results: return base_config.copy()
    recent_cvs = cv_results[-5]; train_r2s = [r.get('train_r2', 0) for r in recent_cvs]; cv_r2s = [r.get('cv_r2', 0) for r in recent_cvs]
    
    if all(r < -0.2 for r in cv_r2s[-3:]) and all(r < 0 for r in train_r2s[-3:]):
        optimized = base_config.copy(); optimized['lgb_params']['max_depth'] = min(base_config['lgb_params'].get('max_depth', 6) + 1, 10)
        optimized['lgb_params']['num_leaves'] = min(base_config['lgb_params'].get('num_leaves', 31) + 16, 127)
        optimized['lgb_params']['learning_rate'] = max(base_config['lgb_params'].get('learning_rate', 0.005) * 1.5, 0.01)
        logger.info(f"[{symbol}] 检测到持续欠拟合，增加模型复杂度和学习率")
        return optimized
    
    if len(train_r2s) >= 3 and len(cv_r2s) >= 3:
        train_avg = np.mean(train_r2s[-3]); cv_avg = np.mean(cv_r2s[-3])
        if train_avg - cv_avg > 0.3:
            optimized = base_config.copy()
            optimized['lgb_params']['reg_alpha'] = min(base_config['lgb_params'].get('reg_alpha', 0.1) * 2, 2.0)
            optimized['lgb_params']['reg_lambda'] = min(base_config['lgb_params'].get('reg_lambda', 0.5) * 2, 5.0)
            optimized['lgb_params']['subsample'] = max(base_config['lgb_params'].get('subsample', 0.8) - 0.1, 0.5)
            logger.info(f"[{symbol}] 检测到过拟合趋势，加强正则化")
            return optimized
    
    if len(cv_r2s) >= 3 and cv_r2s[-1] < cv_r2s[-2] < cv_r2s[-3]:
        best_config = None; best_cv_r2 = -float('inf')
        for params in _generate_param_combinations(base_config):
            try: local_cv_r2 = quick_cv_evaluation(symbol, params)  # 简化的快速CV评估
                if local_cv_r2 > best_cv_r2: best_cv_r2 = local_cv_r2; best_config = params
            except Exception: continue
        if best_config: logger.info(f"[{symbol}] 性能衰退，切换到新超参数组合"); return best_config
    
    if base_config.get('needs_adaptive_retrain', False):
        optimized = base_config.copy(); optimized['lgb_params']['learning_rate'] = 0.001
        optimized['lgb_params']['n_estimators'] = 5000
        logger.info(f"[{symbol}] 触发基础自适应重训：学习率降为0.001，迭代数增至5000")
        return optimized
    
    return base_config.copy()

def _generate_param_combinations(base_config: Dict) -> List[Dict]:
    combos = []
    for md in HYPERPARAM_GRID['max_depth']:
        for nl in HYPERPARAM_GRID['num_leaves']:
            for ra in HYPERPARAM_GRID['reg_alpha']:
                combos.append({'lgb_params': dict(base_config['lgb_params']), 'lgb_params': {'max_depth': md, 'num_leaves': nl, 'reg_alpha': ra}})
    return combos
