import json
from pathlib import Path
from datetime import datetime, timedelta
from typing import Dict, List, Optional
import numpy as np

EVOLUTION_CONFIG = {
    "ic_decay_threshold": 0.3,
    "min_observation_days": 30,
    "retrain_confidence_score": 0.7,
    "lockout_period_days": 7,
}

def check_ic_drift(code: str, recent_window: int = 30, historical_window: int = 90) -> Dict:
    from utils.ic_data_loader import load_recent_ic, load_historic_ic
    
    recent_data = load_recent_ic(code, window=recent_window)
    historic_data = load_historic_ic(code, window=historical_window)
    
    if len(recent_data) < EVOLUTION_CONFIG["min_observation_days"] or \
       len(historic_data) < EVOLUTION_CONFIG["min_observation_days"]:
        return {
            'detected': False, 'recent_ic_mean': None, 'historical_ic_mean': None,
            'ic_change_rate': None, 'stat_test_pvalue': None, 'recommendation': 'insufficient_data'
        }
    
    recent_mean = np.mean(recent_data)
    historical_mean = np.mean(historic_data)
    ic_change_rate = abs(recent_mean - historical_mean) / (abs(historical_mean) + 1e-9)
    
    try:
        from scipy.stats import kstest, ks_2samp
        _, p_value = ks_2samp(recent_data, historic_data)
    except Exception:
        p_value = 1.0
    
    detected = ic_change_rate > EVOLUTION_CONFIG["ic_decay_threshold"] or p_value < 0.05
    recommendation = "retrain" if detected else ("check_quality" if p_value < 0.1 else "no_action")
    
    return {
        'detected': detected,
        'recent_ic_mean': round(float(recent_mean), 4),
        'historical_ic_mean': round(float(historical_mean), 4),
        'ic_change_rate': round(float(ic_change_rate), 4),
        'stat_test_pvalue': round(float(p_value), 4),
        'recommendation': recommendation
    }
