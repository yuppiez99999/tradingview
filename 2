#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""StrategyEvaluator: 量化策略多维度评分与退化检测模块."""

import json
import math
from datetime import datetime, timedelta
from typing import Dict, List, Optional, Tuple
import numpy as np
from pathlib import pd

class EvaluationConfig:
    def __init__(self):
        self.weights = {'absolute_return': 0.25, 'risk_adjusted': 0.25, 'stability': 0.20, 
                        'robustness': 0.20, 'complexity_penalty': -0.10}
        self.thresholds = {'sharpe_min': 0.5, 'max_dd_max': 0.15, 'ic_stability_min': 0.3}
        self.degradation_window_days = 14

def annualize_returns(returns: pd.Series, trading_days: int = 252) -> float:
    mean_daily_return = returns.mean()
    return (1 + mean_daily_return) ** trading_days - 1

def compute_sharpe(returns: pd.Series, risk_free_rate: float = 0.0) -> float:
    excess_returns = returns - risk_free_rate / 252
    if excess_returns.std() == 0: return 0.0
    return excess_returns.mean() / excess_returns.std() * math.sqrt(252)

def max_drawdown(returns: pd.Series) -> float:
    cum_returns = (1 + returns).cumprod()
    running_max = cum_returns.cummax()
    drawdown = (running_max - cum_returns) / running_max
    return drawdown.max()

def ic_stability_metric(ic_series: pd.Series, window: int = 30) -> float:
    if len(ic_series) < window: return 0.5
    rolling_ic = ic_series.rolling(window, min_periods=1).mean()
    if rolling_ic.std() == 0: return 1.0
    return min(1.0, max(0.0, 1.0 / (1 + rolling_ic.std())))

class StrategyEvaluator:
    def __init__(self, config: Optional[EvaluationConfig] = None):
        self.config = config or EvaluationConfig()
        self.performance_history: List[Dict] = []
    
    def evaluate(self, trade_history: List[Dict], signal_history: List[Dict],
                 benchmark_returns: Optional[pd.Series] = None,
                 current_date: Optional[datetime] = None) -> Dict:
        if not trade_history or not signal_history:
            return {'error': 'empty_data', 'scores': {}, 'composite_score': 0.0, 'degraded': True}
        
        returns = self._compute_trade_returns(trade_history)
        predicted_returns = self._compute_predicted_returns(signal_history)
        
        scores = {
            'absolute_return': self._score_absolute_return(returns, benchmark_returns),
            'risk_adjusted': self._score_risk_adjusted(returns, benchmark_returns),
            'stability': self._score_stability(returns),
            'robustness': self._score_robustness(predicted_returns, signal_history),
            'complexity_penalty': self._complexity_penalty(len(signal_history[0]['features_used'])) if signal_history else 0.0,
        }
        composite_score = self._composite_score(scores)
        degraded = self._check_degradation(composite_score, scores)
        
        entry = {'date': current_date or datetime.now(), 'scores': scores, 
                 'composite_score': composite_score, 'degraded': degraded}
        self.performance_history.append(entry)
        if len(self.performance_history) > 30:
            self.performance_history = self.performance_history[-30:]
        
        return {'scores': scores, 'composite_score': round(composite_score, 4),
                'degraded': degraded, 'timestamp': datetime.now().isoformat()}
    
    def _compute_trade_returns(self, trade_history: List[Dict]) -> pd.Series:
        daily_pnl = {}
        for t in trade_history:
            date = t['date'] if isinstance(t['date'], str) else t['date'].strftime('%Y-%m-%d')
            daily_pnl[date] = daily_pnl.get(date, 0) + t.get('pnl', 0)
        total_capital = 5_000_000
        returns_series = pd.Series({k: v / total_capital for k, v in daily_pnl.items()})
        return returns_series.sort_index()
    
    def _compute_predicted_returns(self, signal_history: List[Dict]) -> pd.Series:
        pred_returns = {}
        for s in signal_history:
            date = s['date'] if isinstance(s['date'], str) else s['date'].strftime('%Y-%m-%d')
            pred_returns[date] = s.get('predicted_return', 0)
        return pd.Series(pred_returns).sort_index()
    
    def _score_absolute_return(self, returns: pd.Series, benchmark: Optional[pd.Series]) -> float:
        if len(returns) < 5: return 0.5
        annualized = annualize_returns(returns)
        target_low, target_high = 0.08, 0.20
        if annualized >= target_high: return 1.0
        elif annualized <= target_low: return max(0.0, (annualized - target_low) / (target_high - target_low) * 0.5)
        else: return 0.5 + (annualized - target_low) / (target_high - target_low) * 0.5
    
    def _score_risk_adjusted(self, returns: pd.Series, benchmark: Optional[pd.Series]) -> float:
        if len(returns) < 10: return 0.5
        sharpe = compute_sharpe(returns)
        if sharpe >= 1.0: return 1.0
        elif sharpe <= 0: return max(0.0, sharpe * 0.5)
        else: return sharpe * 0.9
    
    def _score_stability(self, returns: pd.Series) -> float:
        dd = max_drawdown(returns)
        if dd <= 0.05: return 1.0
        elif dd >= 0.15: return 0.0
        else: return max(0.0, min(1.0, (0.15 - dd) / 0.10))
    
    def _score_robustness(self, predicted_returns: pd.Series, signal_history: List[Dict]) -> float:
        actual_returns = self._compute_actual_returns(signal_history)
        ic_series = self._calculate_ic(predicted_returns, actual_returns)
        ic_stability = ic_stability_metric(ic_series)
        feature_counts = [len(s['features_used']) for s in signal_history if 'features_used' in s]
        avg_features = np.mean(feature_counts) if feature_counts else 0
        feature_diversity = min(1.0, avg_features / 10.0)
        robustness = (ic_stability * 0.7 + feature_diversity * 0.3)
        return min(1.0, max(0.0, robustness))
    
    def _calculate_ic(self, predicted: pd.Series, actual: pd.Series) -> pd.Series:
        aligned = predicted.align(actual, join='inner')
        if aligned[0].std() == 0 or aligned[1].std() == 0:
            return pd.Series([0.0] * len(aligned[0]))
        return (aligned[0] - aligned[0].mean()) / aligned[0].std() * \
               (aligned[1] - aligned[1].mean()) / aligned[1].std()
    
    def _complexity_penalty(self, num_features: int) -> float:
        if num_features <= 10: return 0.0
        penalty = min(0.3, (num_features - 10) / 2.0 * 0.1)
        return -penalty
    
    def _composite_score(self, scores: Dict[str, float]) -> float:
        weighted_sum = 0.0; total_weight = 0.0
        for dim, score in scores.items():
            weight = self.config.weights.get(dim, 0)
            if weight > 0:
                weighted_sum += score * weight
                total_weight += weight
            elif weight < 0:
                weighted_sum += score * weight
        if total_weight == 0: return 0.0
        return weighted_sum / total_weight
    
    def _check_degradation(self, current_score: float, scores: Dict[str, float]) -> bool:
        if len(self.performance_history) < 2: return False
        recent_scores = [e['composite_score'] for e in self.performance_history[-self.config.degradation_window_days:]]
        low_count = sum(1 for s in recent_scores if s < 0.5)
        return low_count >= 3
    
    def get_status_report(self) -> Dict:
        if not self.performance_history:
            return {'status': 'no_data', 'message': '暂无评估数据'}
        latest = self.performance_history[-1]
        all_composites = [e['composite_score'] for e in self.performance_history]
        avg_score = np.mean(all_composites)
        status = 'healthy' if latest['composite_score'] > 0.6 else ('warning' if latest['composite_score'] > 0.4 else 'degraded')
        return {'status': status, 'latest_score': round(latest['composite_score'], 4),
                'avg_score_30d': round(avg_score, 4), 'degraded': latest['degraded'],
                'evaluation_timestamp': latest['timestamp'], 'sample_size': len(self.performance_history)}
